# =============================================================================
# TEMPLATE ENVIRONMENT - POS Kasir (backend)
# -----------------------------------------------------------------------------
# Cara pakai:
#   cp backend/.env.example backend/.env
#   lalu sesuaikan nilainya
#
# File .env hanya dibaca oleh backend (github.com/joho/godotenv) dan sudah
# masuk .gitignore, jadi jangan pernah commit isi aslinya ke git.
#
# Urutan prioritas konfigurasi (yang paling atas menang):
#   1. Variabel environment milik proses (POS_*)   -> di-set scripts/dev-backend.mjs
#   2. File .env ini
#   3. backend/config.local.json                   -> ditulis fitur "Ganti Database"
#                                                    pada menu Pengaturan
#   4. backend/config.json                         -> template bawaan
#   5. Nilai default di backend/internal/config/config.go
#
# Catatan: godotenv tidak menimpa variabel yang sudah ada di proses, sehingga
# nilai yang diset `npm run dev` tetap lebih tinggi dari file ini.
# =============================================================================

# Port HTTP backend (default: 8080)
POS_PORT=8080

# Mesin database: sqlite | mysql
# Sengaja dikomentari agar pilihan "Ganti Database" dari UI Pengaturan
# (tersimpan di config.local.json) tidak ditimpa lagi saat backend restart.
# Hapus tanda # di bawah ini untuk memaksa mesin tertentu.
# POS_DB_ENGINE=sqlite

# Path file SQLite, dipakai saat mesin database = sqlite.
# Path relatif dihitung dari folder backend/.
# POS_SQLITE_PATH=pos.db

# DSN MySQL, dipakai saat mesin database = mysql.
# Format: user:password@tcp(host:port)/nama_db?charset=utf8mb4&parseTime=True&loc=Local
# Database akan dibuat otomatis bila belum ada.
POS_MYSQL_DSN=root:@tcp(127.0.0.1:3306)/pos_db?charset=utf8mb4&parseTime=True&loc=Local
